SELECT FirstName,
       LastName,
       Department,
       Email,
       Salary
FROM Employees
WHERE IsActive = 1
ORDER BY Salary DESC;

SELECT Department,
       COUNT(*) AS TotalEmployees,
       AVG(Salary) AS AverageSalary
FROM Employees
GROUP BY Department;
