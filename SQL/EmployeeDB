CREATE TABLE Employees
(
    EmployeeId INT PRIMARY KEY,
    FirstName VARCHAR(50),
    LastName VARCHAR(50),
    Department VARCHAR(50),
    Email VARCHAR(100),
    Salary DECIMAL(10,2),
    JoiningDate DATE,
    IsActive BIT DEFAULT 1
);

